
RewriteEngine On

# Ne jamais appliquer les redirections du site en local
RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
RewriteRule ^ - [END]

# Redirection HTTP -> HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://www.solidarite-logement.org/$1 [R=301,L]

# Redirection vers www si nécessaire
RewriteCond %{HTTP_HOST} !^www\.solidarite-logement\.org$ [NC]
RewriteRule ^(.*)$ https://www.solidarite-logement.org/$1 [R=301,L]

# Redirection sitemap
Redirect 301 /sitemap.php /sitemap.xml

# Désactiver l'affichage des fichiers
Options -Indexes

# Page 404 personnalisée
ErrorDocument 404 /errors/404.php
